<Project InitialTargets="PrintUsings">
  <PropertyGroup>
    <!--<PrometheusLibDirectory Condition="'$(PrometheusLibDirectory)' == ''
                            And '$(IsTestProject)' != 'true'">$(PrometheusDirectory)\lib</PrometheusLibDirectory>
    <PrometheusLibFramework Condition="'$(PrometheusLibFramework)' == ''">netstandard2.0</PrometheusLibFramework>-->
    <UsingsLoaded>True</UsingsLoaded>
  </PropertyGroup>

  <!--<ItemGroup>
    --><!--<PackageReference Include="Prometheus.MSBuild.Tasks" Version="0.2.2-beta.27">
