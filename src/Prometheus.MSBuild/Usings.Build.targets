    <PackageReference Include="Prometheus.MSBuild.Tasks" Version="0.2.2-beta.27" PrivateAssets="all" />
  </ItemGroup>-->

  <ItemGroup Condition="'$(PrometheusSDKTaskBuilder)' != 'true' 
      And '$(IsPackageOnlyProject)' != 'true'">
    <PackageReference Include="Prometheus.MSBuild.Tasks" 
                      Version="0.2.2-beta.27" 
                      PrivateAssets="all" 
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
    <!--<ProjectReference Include="$(PackageDirectory)\Prometheus.MSBuild.Tasks\Prometheus.MSBuild.Tasks.csproj" 
                      IncludeAssets="runtime; build; native; contentfiles; analyzers"
                      Version="0.2.2-beta.15" Condition="'$(PrometheusSDKTaskTester)' == 'true'" />-->
    <!--Condition="'$(PrometheusSDKTaskTester)' == 'true'"-->
    <!--IncludeAssets="runtime; build; native; contentfiles; analyzers"-->
    <!--<PackageReference Include="Prometheus.MSBuild.Tasks" Version="0.2.2-beta.23" IncludeAssets="all" PrivateAssets="all"/>-->
