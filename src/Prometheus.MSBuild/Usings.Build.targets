      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReaFFFfefrence>-->
    <!--<PackageReference Include="Prometheus.MSBuild.Tasks" Version="0.2.2-beta.27" />-->
  </ItemGroup>
  <!--<Import Project="$(PrometheusTaskBuildTargets)" Condition="Exists('$(PrometheusTaskBuildTargets)')" />-->
  <!--<Import Project="$(PrometheusTaskBuildTargets)" Condition="'$(PrometheusTasksEnabled)' == 'true'" />-->
      <!--And Exists('$(PrometheusTaskBuildTargets)')" />-->
  <!--<Import Project="$(LocalNugetRepoDirectory)" />-->
  <!--<Import Project="$(NuGetPackageRoot)\prometheus.msbuild.tasks\0.2.2-beta.23\build\Prometheus.MSBuild.Tasks.props" />
  <Import Project="$(NuGetPackageRoot)\prometheus.msbuild.tasks\0.2.2-beta.23\build\Prometheus.MSBuild.Tasks.targets" />-->
  <!--<Import Project="$(LocalNugetRepoDirectory)" 
          Condition="'$(PrometheusTasksEnabled)' == 'true' And Exists('$(LocalNugetRepoDirectory)')"/>-->
  
  <!--<PropertyGroup>
    <PrometheusLibFramework Condition="'$(TargetFramework)' == ''">$(TargetFramework)</PrometheusLibFramework>
  </PropertyGroup>
  
  <PropertyGroup>
    <PrometheusTaskAssembly>$(PrometheusLibDirectory)\$(PrometheusLibFramework)\Prometheus.MSBuild.Tasks.dll</PrometheusTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Prometheus.MSBuild.Tasks.AttachDebuggerTask"
             AssemblyFile="$(PrometheusTaskAssembly)"
             Condition="'$(PrometheusTasksEnabled)' == 'true' And '$(Configuration)' == 'debug'" />

  <UsingTask TaskName="Prometheus.MSBuild.Tasks.LogPropertyTask"
             AssemblyFile="$(PrometheusTaskAssembly)"
             Condition="'$(PrometheusTasksEnabled)' == 'true'" />

  <UsingTask TaskName="Prometheus.MSBuild.Tasks.DetectPlatformTask"
             AssemblyFile="$(PrometheusTaskAssembly)"
             Condition="'$(PrometheusTasksEnabled)' == 'true'" />

  <UsingTask TaskName="Prometheus.MSBuild.Tasks.CreateLogFormattingTask"
             AssemblyFile="$(PrometheusTaskAssembly)"
             Condition="'$(PrometheusTasksEnabled)' == 'true'" />

  <UsingTask TaskName="Prometheus.MSBuild.Tasks.ImportFileTask"
             AssemblyFile="$(PrometheusTaskAssembly)"
             Condition="'$(PrometheusTasksEnabled)' == 'true'" />-->

  <Target Name="PrintUsings">
    <PropertyGroup>
      <SectionSymbol>%</SectionSymbol>
    </PropertyGroup>

    <Message Text="| $(SectionString)" Importance="high" />
    <Message Text="| []==~ $(MSBuildThisFile) ~==[]" Importance="high" />
    <Message Text="| $(HeaderString)" Importance="high" />
    
    <Message Text="| $(SectionSymbol) MSBuildRuntimeType: $(MSBuildRuntimeType)" Importance="high" />
    <Message Text="| $(SectionSymbol) PrometheusLibDirectory: $(PrometheusLibDirectory)" Importance="high" />
    <Message Text="| $(SectionSymbol) PrometheusLibFramework: $(PrometheusLibFramework)" Importance="high" />
    <Message Text="| $(SectionSymbol) PrometheusUsingsLoaded: $(PrometheusUsingsLoaded)" Importance="high" />
    <Message Text="| $(SectionSymbol) PrometheusTaskAssembly: $(PrometheusTaskAssembly)" Importance="high" />
  </Target>
</Project>