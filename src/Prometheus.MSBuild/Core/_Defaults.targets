<Project InitialTargets="_PrintPrometheusGlobals">
  <!--<Import Project="$(PrometheusCoreProps)" Condition="Exists('$(PrometheusCoreProps)')
      And '$(PrometheusCorePropsLoaded)' != 'true'" />-->
  <Import Project="$(SolutionProps)" Condition="Exists($(SolutionProps))"/>
  <Import Project="$(UserProps)" Condition="Exists($(UserProps))" />
  <!--<Import Project="($(PrometheusTestsTargets)" Condition="('$(IsTestProject)' == 'true' 
      Or '$(HasTests)' == 'true') 
      And Exists($(PrometheusTestsTargets))" />-->
  
  <PropertyGroup>
    <Product Condition="'$(Product)' == '' 
        And '$(ProductName)' != ''">$(ProductName)</Product>
    <CopyrightStartYear Condition="'$(CopyrightStartYear)' == ''">1900</CopyrightStartYear>
    <AssemblyName Condition="'$(AssemblyName)' == '' And '$(Product)' != ''">$(Product)</AssemblyName>
    <Company Condition="'$(Company)' == ''
        And '$(CompanyName)' != ''">$(CompanyName)</Company>
    <Authors Condition="'$(AuthorName)' != ''">$(AuthorName);$(Authors)</Authors>
    <Owners Condition="'$(Owners)' != ''">$(Company);$(Owners)</Owners>
    <Copyright>copyright © $(CompanyName) $(CopyrightStartYear)-$([System.DateTime]::Now.Year)</Copyright>
    <Version Condition="'$(Version)' == ''
        And '$(ProductVersion)' != ''">$(ProductVersion)</Version>
    <FileVersion Condition="'$(FileVersion)' == ''
        And '$(Version)' != ''">$(Version)</FileVersion>
  </PropertyGroup>

  <!--<PropertyGroup Condition="$(SolutionDir) != ''">
    --><!--<SolutionDir>$(SolutionDir.TrimEnd('\'))</SolutionDir>--><!--
    <SourceDirectory Condition=" '$(SourceDirectory)' == '' ">$(SolutionDir)src</SourceDirectory>
    <ThirdPartyDirectory Condition=" '$(ThirdPartyDirectory)' == '' ">$(SolutionDir)third-party</ThirdPartyDirectory>
    <BuildDirectory Condition="'$(BuildDirectory)' == ''">$(SolutionDir)build</BuildDirectory>
    <PackageDirectory Condition="'$(PackageDirectory)' == ''">$(SolutionDir)package</PackageDirectory>
    --><!--<PrometheusDirectory Condition=" '$(PrometheusDirectory)' == '' ">$(PrometheusDirectory)\Prometheus</PrometheusDirectory>--><!--
    <OutputDirectory Condition="'$(OutputDirectory)' == ''">$(BuildDirectory)\bin\$(Configuration)\$(AssemblyName)</OutputDirectory>
    <OutputPath Condition="'$(OutputPath)' == ''
        And '$(OutpitDirectory)' != ''">$(OutputDirectory)</OutputPath>
    <BaseIntermediateOutputPath>$(BuildDirectory)\obj\$(Configuration)\$(AssemblyName)</BaseIntermediateOutputPath>
    <SolutionProps Condition=" '$(SolutionProps)' == '' ">$(SolutionDir)Solution.Build.props</SolutionProps>
    <UserProps Condition=" '$(UserProps)' == '' ">$(SolutionDir)User.Build.props</UserProps>
    <SolutionImportProps Condition="'$(SolutionImportProps)' == ''">$(SolutionDir)Imports.Build.props</SolutionImportProps>
  </PropertyGroup>-->
  
  <Import Project="$(PrometheusDebugTargets)" 
          Condition="'$(Configuration)' == 'debug'
          And Exists('$(PrometheusDebugTargets)')" />

  <PropertyGroup Condition="'$(IsPackageOnlyProject)' == 'true'">
    <!--<EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>-->
    <NoWarn>$(NoWarn);2008;8021</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--<NuspecFile>$(MSBuildThisFileDirectory)templates.nuspec</NuspecFile>-->
    <!--<CopyBuildOutputToOutputDirectory></CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory></CopyOutputSymbolsToOutputDirectory>
    <IsProjectReferenceProvider></IsProjectReferenceProvider>-->
    <MergeBinary>false</MergeBinary>
    <IsPackable>true</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableShinFramework>false</EnableShinFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true' 
      Or '$(ForcePack)' == 'true'">
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMSBuildTaskLibraryProject)' == 'true'">
    <IsLibraryProject>true</IsLibraryProject>
    <!-- This target will run when MSBuild is collecting the files to be packaged, and we'll implement it below. This property controls the dependency list for this packaging process, so by adding our custom property we hook ourselves into the process in a supported way. -->
    <TargetsForTfmSpecificBuildOutput>
      $(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
    </TargetsForTfmSpecificBuildOutput>
    <!-- This property tells MSBuild where the root folder of the package's build assets should be. Because we are not a library package, we should not pack to 'lib'. Instead, we choose 'tasks' by convention. -->
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <!-- NuGet does validation that libraries in a package are exposed as dependencies, but we _explicitly_ do not want that behavior for MSBuild tasks. They are isolated by design. Therefore we ignore this specific warning. -->
    <NoWarn>NU5100</NoWarn>
    <!-- Suppress NuGet warning NU5128. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  
  <PropertyGroup Label="Configure assembly names and namespaces" Condition="$(PrometheusPlatformEnabled) == 'true'">
    <!--<TargetFrameworks>netstandard2.1;net5.0;netcoreapp3.1</TargetFrameworks>-->
    <RootNamespace Condition="'$(RootNamespace)' == ''">$(AssemblyName)</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLibraryProject)' == 'true'">
    <OutputType>Library</OutputType>
    <DocumentationFile>$(OutputDirectory)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Normalize stack trace file locations" Condition="$(BuildingInsideVisualStudio) != 'true'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=X:\</PathMap>
  </PropertyGroup>
  
  <Import Project="$(PrometheusGlobalDirectory)\NuGet.Build.targets" Condition="'$(IsPackable)' == 'true'" />
</Project>
