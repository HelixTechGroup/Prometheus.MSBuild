<Project>
  <PropertyGroup>
    <DirectoryBuildFileAbove>[MSBuild]::GetPathOfFileAbove('$(MSBuildThisFile)', '$(MSBuildThisFileDirectory)../')</DirectoryBuildFileAbove>
  </PropertyGroup>
  <Import Project="$(DirectoryBuildFileAbove)" Condition="Exists('$(DirectoryBuildFileAbove)')" />
  <PropertyGroup>
    <SectionSymbol>@</SectionSymbol>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!--<TargetFrameworks>net6.0;netcoreapp3.1;netstandard2.1;net40;</TargetFrameworks>-->
    <!--<TargetFramework>net5.0;monoandroid90;net40;net5.0;netcoreapp3.1;netstandard2.1;</TargetFramework>-->
    <LocalNugetRepoDirectory>D:\Users\Bryan\Documents\Projects\HelixTechGroup\local-nuget</LocalNugetRepoDirectory>
    <IsLibraryProject>true</IsLibraryProject>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Description>The Prometheus Framework is a set of msbuild targets and properties that automate the creation of creation of cross-platform or platform specific projects</Description>
    <PackageTags>MSBuild MSBuildSdk android windows linux cross-platform dotnet build-tool build-tools crossplatform msbuild-sdk msbuild-tasks</PackageTags>
    <BuildPackage>true</BuildPackage>
    <IsPackable>true</IsPackable>
    <RepositoryHttpUrl>https://github.com/HelixTechGroup/Prometheus.MSBuild</RepositoryHttpUrl>
    <UseGitHub>True</UseGitHub>
    <RepositoryHttpUrl>https://github.com/HelixTechGroup/Prometheus.MSBuild</RepositoryHttpUrl>
    <!--<PrometheusLibDirectory>$(PrometheusDirectory)\lib</PrometheusLibDirectory>-->

    <!--D:\Users\Bryan\Documents\Projects\HelixTechGroup\Design\Prometheus\msbuild\-->
    <!--<RootDirectory>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), README.md))</RootDirectory>-->
    <!--<PrometheusDirectory>$(RootDirectory)\src\Prometheus.MSBuild</PrometheusDirectory>-->
    <!--<PrometheusLibDirectory>$(RootDirectory)\build\Debug\Prometheus.MSBuild.Tasks</PrometheusLibDirectory>-->
    <!--<PrometheusCoreDirectory>$(PrometheusDirectory)\Globals</PrometheusCoreDirectory>
    <PrometheusGlobalProps>$(PrometheusCoreDirectory)\Globals.Build.props</PrometheusGlobalProps>
    <PrometheusGlobalTargets>$(PrometheusCoreDirectory)\Globals.Build.targets</PrometheusGlobalTargets>-->
    <PrometheusLoadType>Lite</PrometheusLoadType>
    <PrometheusPlatformEnabled>False</PrometheusPlatformEnabled>
    <PrometheusTasksEnabled>False</PrometheusTasksEnabled>
    <PrometheusEnabled>True</PrometheusEnabled>
    <!--<HasTests>True</HasTests>-->
  </PropertyGroup>

  <PropertyGroup>
    <CompanyName>HelixTechGroup,llc</CompanyName>
    <AuthorName>Bryan M. Longacre</AuthorName>
    <!--<ProductVersion>0.2.0-preview</ProductVersion>-->
  </PropertyGroup>

  <!--<Target Name="NugetCopy" AfterTargets="Build">
    <CallTarget Targets="CopyToLocalNuGetRepo" />
  </Target>-->
  <!--<Target Name="CopyTasksToLib" BeforeTargets="Pack">
    <ItemGroup>
      <LibFiles Include="..\Prometheus.MSBuild.Tasks\bin\$(Configuration)\net48\**" Exclude="$(NugetPackageName)"/>
    </ItemGroup>
    <Message Text="| []==~~ Copying Tasks library to Lib directory ~~==[]" Importance="high" />
    <Copy DestinationFolder="$(PrometheusLibDirectory)"
          SourceFiles="@(LibFiles)" OverwriteReadOnlyFiles="True" SkipUnchangedFiles="True"/>
  </Target>-->
</Project>
