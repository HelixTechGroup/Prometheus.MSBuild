<Project SDK="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PrometheusTasksEnabled>False</PrometheusTasksEnabled>
    <!--<PrometheusLibDirectory>$(BuildDirectory)\$(Configuration)</PrometheusLibDirectory>-->
  </PropertyGroup>
  <!--<Sdk Name="Microsoft.Build.NoTargets" Version="2.0.1" /> Microsoft.NET.Sdk  MSBuild.Sdk.Extras/3.0.22-->
